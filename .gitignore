/.audit

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*~

# Claude Code
.claude/

# macOS duplicate files (from parallel Claude Code sessions)
*\ [0-9].ts
*\ [0-9].tsx
*\ [0-9].js
*\ [0-9].jsx
*\ [0-9].json
*\ [0-9].css
*\ [0-9].md
*\ copy.ts
*\ copy.tsx
*\ copy.js
*\ copy.jsx

# Playwright / E2E testing (do not push test artifacts to GitHub)
.playwright-mcp/
playwright.config.ts
playwright-report/
test-results/
e2e/

# Generated artifacts
artifacts/

# Backup directories
.git_old/

# Separate projects (not part of Next.js app)
remotion-demo/

# Demo video (rendered from remotion-demo)
stitch/
.stitch/
